# Copy outside the repository, e.g. ~/.config/yandex-backup/.env
# Only the access token is required for file operations and the macOS worker.
YANDEX_ACCESS_TOKEN=
# Optional: used by auth login / auth refresh.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://oauth.yandex.ru/verification_code
